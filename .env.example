# App principal
# local: modo desarrollo
# production: modo build/start para simular prod
APP_ENV=local

# Puerto de la app principal
PORT=3000

# Persistencia de la app principal
# in-memory: default, útil para tests y demo rápida
# postgres: usa Docker/Postgres
PERSISTENCE=in-memory

# Base local de Postgres usada por la app principal y el módulo de seguridad
DATABASE_URL=postgres://cashea:cashea@localhost:5432/cashea_challenge

# Módulo de seguridad
# Puerto del server aislado que monta /insecure y /secure
INSECURE_PORT=3001

# Secret local para firmar/verificar JWT en /secure
# En prod/pipeline debe venir desde variables seguras del ambiente, no hardcodeado.
JWT_SECRET=dev_secret_for_security_review